def no_lang_env():
    env = dict(os.environ)
    for j in unix_locale_envs:
        if j in env:
            del env[j]
    return env


def run_cmd(cmd):
    """Run a command and return (exitcode, stdout)."""
    env = no_lang_env()
    try:
        out = subprocess.check_output(cmd, text=True, stderr=subprocess.STDOUT, env=env)
        return 0, out
    except subprocess.CalledProcessError as e:
        return e.returncode, e.output


def parse_btrfs_usage_k(mountpoint, uuid):
    """
    Parse `btrfs filesystem usage -k <mountpoint>` and return metadata info.

    Returns:
      two dicts, one for metadata,one for data, each of the form
      {
        "profile": "DUP" or "RAID1" or "single" or None,
        "size_kib": float,
        "used_kib": float,
        "free_kib": float,
        "free_ratio": float  # free_kib / size_kib
      }
    Or None on parse error.
    """
    rc, out = run_cmd(["btrfs", "filesystem", "usage", "-k", mountpoint])
    if rc != 0:
        print(f"✗ btrfs filesystem usage failed on {mountpoint}:")
        if out:
            print(out.strip())
        return None

    # Metadata lines
    # Metadata,DUP: Size:10429440.00KiB, Used:8083104.00KiB (77.50%)
    # Metadata, RAID1: total=..., used=...  <-- older/different format sometimes
    # We'll attempt to match the common "Size:..., Used:..." form first.
    m = re.search(
        r"^Metadata(?:,\s*([^:]+))?:\s*Size:([0-9.]+)KiB,\s*Used:([0-9.]+)KiB",
        out,
        flags=re.MULTILINE | re.IGNORECASE
    )
    # Fallback: sometimes the output uses `total=... used=...` format per profile
    if not m:
        m = re.search(
            r"^Metadata(?:,\s*([^:]+))?:\s*total=([0-9.]+)KiB,\s*used=([0-9.]+)KiB",
            out,
            flags=re.MULTILINE | re.IGNORECASE
        )

    if not m:
        print(f"✗ Could not find Metadata line in btrfs usage output for {mountpoint}.")
        print("   Raw output:")
        print(out)
        return None

    profile = m.group(1)
    size_kib = float(m.group(2))
    used_kib = float(m.group(3))
    free_kib = size_kib - used_kib
    free_ratio = (free_kib / size_kib) if size_kib > 0 else 0.0

    # Normalize profile (strip whitespace/commas)
    if profile:
        profile = profile.strip().upper()

    data_profile = None
    data_size_kib = data_used_kib = data_free_kib = data_free_ratio = None
    data_match = re.search(
        r"^Data(?:,\s*([^:]+))?:\s*Size:([0-9.]+)KiB,\s*Used:([0-9.]+)KiB",
        out,
        flags=re.MULTILINE | re.IGNORECASE
    )
    if not data_match:
        data_match = re.search(
            r"^Data(?:,\s*([^:]+))?:\s*total=([0-9.]+)KiB,\s*used=([0-9.]+)KiB",
            out,
            flags=re.MULTILINE | re.IGNORECASE
        )
    if data_match:
        data_profile = data_match.group(1)
        if data_profile:
            data_profile = data_profile.strip().upper()
        data_size_kib = float(data_match.group(2))
        data_used_kib = float(data_match.group(3))
        data_free_kib = data_size_kib - data_used_kib
        data_free_ratio = (data_free_kib / data_size_kib) if data_size_kib > 0 else 0.0

    now, hostname = _now_host()
    return {
        "timestamp" : now, 
        "host" : hostname,
        "device" : mountpoint,
        "uuid" : uuid,
        'type': 'metadata', 
        "profile": profile,
        "size_kib": size_kib,
        "used_kib": used_kib,
        "free_kib": free_kib,
        "free_ratio": free_ratio,
    }, {
        "timestamp" : now, 
        "host" : hostname,
        "device" : mountpoint,
        'type': 'data', 
        "uuid" : uuid,
        "profile": data_profile,
        "size_kib": data_size_kib,
        "used_kib": data_used_kib,
        "free_kib": data_free_kib,
        "free_ratio": data_free_ratio,
    }

def human_size(kib):
    """
    Convert a size in KiB to a human-readable string (MiB or GiB).
    """
    try:
        kib = float(kib)
    except (TypeError, ValueError):
        return str(kib)

    mib = kib / 1024.0
    gib = mib / 1024.0

    if gib >= 1.5:
        return f"{gib:.2f} GiB"
    else:
        return f"{mib:.2f} MiB"

    

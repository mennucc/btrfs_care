def extract_mountpoints_recursive(fs_entry, mountpoints):
    """Recursively extracts all mountpoints from a findmnt JSON entry."""
    if 'target' in fs_entry and 'source' in fs_entry:
        mountpoints.append({
            'target': fs_entry['target'],
            'source': fs_entry['source']
        })
    
    if 'children' in fs_entry:
        for child in fs_entry['children']:
            extract_mountpoints_recursive(child, mountpoints)

def get_filesystem_uuid(mountpoint):
    """Retrieves the UUID of the mounted filesystem."""
    try:
        env = no_lang_env()
        result = subprocess.run(
            ['btrfs', 'filesystem', 'show', mountpoint],
            capture_output=True,
            text=True,
            check=True,
            env=env
        )
        # Search for UUID in output
        match = re.search(r'uuid:\s+([a-f0-9-]+)', result.stdout, re.IGNORECASE)
        if match:
            return match.group(1)
    except subprocess.CalledProcessError:
        pass
    return None

def get_btrfs_mountpoints():
    """Retrieves all btrfs mountpoints, avoiding duplicates."""
    try:
        result = subprocess.run(
            ['findmnt', '--json', '-t', 'btrfs'],
            capture_output=True,
            text=True,
            check=True
        )
        data = json.loads(result.stdout)
        
        all_mountpoints = []
        if 'filesystems' in data:
            for fs in data['filesystems']:
                extract_mountpoints_recursive(fs, all_mountpoints)
        
        # Filter duplicates based on UUID
        seen_uuids = set()
        unique_mountpoints = []
        
        for mp in all_mountpoints:
            uuid = get_filesystem_uuid(mp['target'])
            if uuid and uuid not in seen_uuids:
                seen_uuids.add(uuid)
                unique_mountpoints.append({
                    'target': mp['target'],
                    'source': mp['source'],
                    'uuid': uuid
                })
            elif not uuid:
                # If we can't get UUID, include it anyway
                unique_mountpoints.append({
                    'target': mp['target'],
                    'source': mp['source'],
                    'uuid': None
                })
        
        return unique_mountpoints
    except subprocess.CalledProcessError as e:
        print(f"Error retrieving btrfs mountpoints: {e}")
        return []
    except json.JSONDecodeError as e:
        print(f"JSON parsing error: {e}")
        return []

def is_shutdown_in_progress():
    """Checks if system shutdown/reboot is in progress."""
    # Method 1: Check for shutdown.target being active
    try:
        result = subprocess.run(
            ['systemctl', 'is-active', 'shutdown.target'],
            capture_output=True,
            text=True
        )
        if result.stdout.strip() == 'active':
            return True
    except (subprocess.CalledProcessError, FileNotFoundError):
        pass
    
    # Method 2: Check systemd state
    try:
        result = subprocess.run(
            ['systemctl', 'is-system-running'],
            capture_output=True,
            text=True
        )
        state = result.stdout.strip()
        if state in ('stopping', 'offline'):
            return True
    except (subprocess.CalledProcessError, FileNotFoundError):
        pass
    
    # Method 3: Check for /run/systemd/shutdown/scheduled file
    if os.path.exists('/run/systemd/shutdown/scheduled'):
        return True
    
    # Method 4: Check if runlevel is 0 or 6 (halt or reboot)
    try:
        result = subprocess.run(
            ['runlevel'],
            capture_output=True,
            text=True
        )
        output = result.stdout.strip()
        if output.endswith('0') or output.endswith('6'):
            return True
    except (subprocess.CalledProcessError, FileNotFoundError):
        pass
    
    return False

def parse_scrub_status(mountpoint):
    """Parses the scrub status and returns status info."""
    result = None
    try:
        env = no_lang_env()
        result = subprocess.run(
            ['btrfs', 'scrub', 'status', mountpoint],
            capture_output=True,
            text=True,
            check=True,
            env=env
        )
        
        status_text = result.stdout
        status_lines = status_text.split('\n')

        info = {
            'status': None,
            'last_run': None,
            'errors': False,
            'raw_output': status_text
        }
                
        
        # Check if scrub is running
        for line in status_lines:
            line_lower = line.lower().strip()
            if line_lower.startswith('scrub started'):
                # Parse last scrub date
                # Format: "Scrub started:    Fri Oct 17 20:08:59 2025"
                date_match = re.search(r'scrub started:\s+(.+?)$', line.strip(), re.IGNORECASE)
                if date_match:
                    date_str = date_match.group(1).strip()
                    try:
                        # Try to parse the date
                        info['last_run'] = datetime.strptime(date_str, '%a %b %d %H:%M:%S %Y')
                    except ValueError:
                        pass
            elif line_lower.startswith('status'):
                if 'finished' in line_lower:
                    info['status'] = 'finished'
                elif 'running' in line_lower:
                    info['status'] = 'running'
                # Check if scrub was aborted/stopped
                elif any(c  in line_lower for c in ('aborted', 'interrupted', 'paused')):
                    info['status'] = 'resumable'
                else:
                    print(' Internal program error, unrecognized status: ',line)
                    info['status'] = line_lower.split()[-1]
            # Check for errors
            elif line_lower.startswith('error summary:'):
                if 'no errors found' not in line_lower:
                    info['errors'] = line.split(':',maxsplit=1)[-1].strip()
            elif line_lower:
                l = line.split(':', maxsplit=1)
                if len(l)==2:
                    info[l[0].lower().strip()] = l[1].strip()
                else:
                    print(' Ignored status line',l)
        #print(status_text)
        #print(json.dumps(info,indent=2,default=str))
        return info
        
    except subprocess.CalledProcessError as e:
        print(f"✗ Error when reading scrub status on {mountpoint} : {e}")
        if e.stderr:
            print(f"Stderr: {e.stderr}")
        return None

def run_scrub(mp_info, max_age_days=SCRUB_MAX_AGE_DAYS):
    """Performs scrub on a btrfs mountpoint."""
    mountpoint = mp_info['target']
    uuid = mp_info.get('uuid', 'unknown')
    
    print(f"\n{'='*60}")
    print(f"Starting scrub on: {mountpoint}")
    print(f"Device: {mp_info['source']}")
    print(f"UUID: {uuid}")
    print(f"{'='*60}")
    
    # Check current scrub status
    info = parse_scrub_status(mountpoint)
    if not info:
        print("✗ Could not read scrub status")
        return False
        
    status = info['status']
    # If scrub is running, skip
    if status == 'running':
        print("⚠️  A scrub is already running on this filesystem")
        if "time left" in info:
            print("     and will end in ",info["time left"])
        print("   Skipping scrub and balance for this filesystem.")
        return 'skip'
    
    # If scrub was aborted, resume it
    if 'resumable' ==  status:
        print("⚠️  Previous scrub was aborted. Resuming...")
        env = no_lang_env()
        try:
            result = subprocess.run(
                NOACT + ['btrfs', 'scrub', 'resume', '-B', mountpoint],
                capture_output=True,
                text=True,
                check=True,
                env=env
            )
            print(result.stdout)
            print("✓ Scrub resumed and completed")
            
            # Check for errors after resume
            info = parse_scrub_status(mountpoint)
            if info and info['errors']:
                print("⚠️  WARNING: Scrub reported errors!")
                return False
            
            return True
        except subprocess.CalledProcessError as e:
            print(f"✗ Error resuming scrub: {e}")
            if e.stdout:
                print(f"Stdout: {e.stdout}")
            if e.stderr:
                print(f"Stderr: {e.stderr}")
            return False
    
    # Check if last scrub was recent
    if info['last_run']:
        age = datetime.now() - info['last_run']
        print(f"ℹ️  Last scrub: {info['last_run'].strftime('%Y-%m-%d %H:%M:%S')} ({age.days} days ago)")
        
        if age.days < max_age_days:
            print(f"✓ Scrub is recent (< {max_age_days} days), skipping...")
            
            # Check if there were errors in last scrub
            if info['errors']:
                print("⚠️  WARNING: Last scrub reported errors!")
                return False
            
            return True

    # Run scrub
    print("Starting new scrub...")
    try:
        env = no_lang_env()
        result = subprocess.run(
            NOACT + ['btrfs', 'scrub', 'start', '-c', '2', '-B', mountpoint],
            capture_output=True,
            text=True,
            check=True,
            env=env
        )
        
        print(result.stdout)
        
        # Check for errors in scrub
        if 'error' in result.stdout.lower() and 'no errors found' not in result.stdout.lower():
            # Look for error count
            errors = re.search(r'(\d+)\s+error', result.stdout, re.IGNORECASE)
            if errors and int(errors.group(1)) > 0:
                print(f"⚠️  WARNING: Found {errors.group(1)} errors!")
                return False
        
        print("✓ Scrub completed without errors")
        return True
        
    except subprocess.CalledProcessError as e:
        print(f"✗ Error during scrub: {e}")
        if e.stdout:
            print(f"Stdout: {e.stdout}")
        if e.stderr:
            print(f"Stderr: {e.stderr}")
        return False


    
def run_balance(mp_info):
    """Performs incremental balance on a btrfs mountpoint."""
    mountpoint = mp_info['target']
    
    print(f"\n{'='*60}")
    print(f"Starting balance on: {mountpoint}")
    print(f"{'='*60}")

    def usage_levels():
        """Generator for usage levels (0% to 90%)."""
        for j in range(0, 91, 10):
            yield '-dusage=' + str(j)
        for j in range(0, 91, 10):
            yield '-musage=' + str(j)
    
    for opt in usage_levels():
        try:
            env = no_lang_env()
            print(f"\n→ Running balance with {opt}...")
            result = subprocess.run(
                NOACT + ['btrfs', 'balance', 'start', opt, mountpoint],
                capture_output=True,
                text=True,
                check=True,
                env=env
            )
            print(result.stdout,end='')
            #print(f"✓ Balance {opt} completed successfully")
        except subprocess.CalledProcessError as e:
            print(f"✗ Error during balance {opt}: {e}")
            if e.stderr:
                print(f"Stderr: {e.stderr}")
            return False
    
    print(f"\n✓ All balance operations completed for {mountpoint}")
    return True

def check_root():
    """Verifies if the script is run as root."""
    if subprocess.run(['id', '-u'], capture_output=True, text=True).stdout.strip() != '0':
        print("⚠️  This script requires root privileges.")
        print("Run it with: sudo python3 script.py")
        return False
    return True

def main():
    args = parse_args()

    if args.scrub_max_age_days < 0:
        print("⚠️  --scrub-max-age-days must be zero or a positive integer.")
        sys.exit(2)

    global NOACT
    NOACT = ['echo'] if args.no_act else []

    scrub_max_age_days = args.scrub_max_age_days

    print("Btrfs Maintenance Script")
    print("="*60)
    print(f"Configuration: Skip scrub if last run was < {scrub_max_age_days} days ago")
    mode = "Dry-run (commands will be echoed)" if args.no_act else "Live execution"
    print(f"Mode: {mode}")
    print("="*60)
    
    # Check root privileges
    if not check_root():
        sys.exit(1)
    
    # Get btrfs mountpoints
    mountpoints = get_btrfs_mountpoints()
    
    if not mountpoints:
        print("No mounted Btrfs partitions found.")
        sys.exit(0)
    
    print(f"\nFound {len(mountpoints)} unique Btrfs partitions:")
    for mp in mountpoints:
        print(f"  - {mp['target']} ({mp['source']}) UUID: {mp.get('uuid', 'N/A')}")
    
    # Process each mountpoint
    scrub_ok = True
    for mp_info in mountpoints:
        # Check if shutdown is in progress
        if is_shutdown_in_progress():
            print("\n⚠️  System shutdown detected! Exiting gracefully...")
            sys.exit(0)
        
        # if the previous scrub had problems, maybe host is shutting down,
        # or disks have a problem... let's wait a bit
        if not scrub_ok:
            time.sleep(5)

        mountpoint = mp_info['target']
        uuid = mp_info.get('uuid', 'unknown')
        target = mp_info['target']
        source = mp_info['source']
    
        print(f"\n{'='*60}")
        print(f"Working on: {target}")
        print(f"Device: {source}")
        print(f"UUID: {uuid}")
            
        metadata_allocation_info(target)
            
        # Run scrub
        scrub_ok = run_scrub(mp_info, max_age_days=scrub_max_age_days)
        
        # If scrub is ok, run balance
        # If scrub returned 'skip', don't run balance
        if scrub_ok == 'skip':
            print(f"\n⚠️  Skipping balance for {mp_info['target']} (scrub is running)")
        elif scrub_ok:
            run_balance(mp_info)
        else:
            print(f"\n⚠️  Balance skipped for {mp_info['target']} due to scrub errors")
    
    print("\n" + "="*60)
    print("Maintenance completed")
    print("="*60)

if __name__ == "__main__":
    main()
 

BTRFS_JOURNAL_RE = re.compile(
    r'^(?P<prefix>.+?):\s+BTRFS\s+(?P<level>\w+)\s+\(device\s+(?P<device>[^\)]+)\):\s+(?P<body>.+)$'
)
ROOT_RE = re.compile(r'root\s+(\d+)', re.IGNORECASE)
INODE_RE = re.compile(r'inode\s+(\d+)', re.IGNORECASE)
PATH_RE = re.compile(r'\(path:\s*(?P<path>[^)]+)\)')
LOGICAL_RE = re.compile(r'logical\s+(\d+)', re.IGNORECASE)
PHYSICAL_RE = re.compile(r'physical\s+(\d+)', re.IGNORECASE)
OFFSET_RE = re.compile(r'offset\s+(\d+)', re.IGNORECASE)
LENGTH_RE = re.compile(r'length\s+(\d+)', re.IGNORECASE)
SUBVOL_RE = re.compile(r'^ID\s+(\d+)\s+.*\spath\s+(.+)$')


def fetch_btrfs_journal(max_lines=JOURNAL_MAX_LINES):
    """Retrieve recent kernel log lines so we can search for Btrfs errors."""
    rc, out = run_cmd([
        'journalctl', '-k', '--no-pager', '--output=short-iso',
        '-n', str(max_lines)
    ])
    ## to test...
    #out=open(os.path.expanduser('~/src/btrfs_care/btrfs_error_journalctl.txt')).read()
    
    if rc != 0:
        print("⚠️  Unable to read kernel journal; skipping error scan.")
        return ""
    return out


def _normalize_block_device(source):
    """Extract block-device identifiers used inside kernel log lines."""
    if not source:
        return None, [], []
    device = source.split('[', 1)[0].strip()
    token = device
    markers = []
    if device:
        markers.append(f"device {device}")
    if device.startswith('/dev/'):
        token = os.path.basename(device)
        markers.append(f"device {token}")
    elif device and not device.startswith('/'):
        markers.append(f"device /dev/{device}")
    return device, token, markers


def _append_log(path, line, rotate_size=None):
    if not path:
        return
    try:
        with open(path, 'a', encoding='utf-8') as handle:
            handle.write(line + '\n')
    except OSError as exc:
        print(f"⚠️  Unable to write to error log {path}: {exc}")
        return
    if rotate_size:
        try:
            if os.path.getsize(path) > rotate_size:
                for idx in range(4, 0, -1):
                    older = f"{path}.{idx}"
                    newer = f"{path}.{idx - 1}" if idx > 1 else path
                    if os.path.exists(newer):
                        os.replace(newer, older)
                with open(path, 'w', encoding='utf-8'):
                    pass
        except OSError:
            pass


def parse_subvolume_paths(target):
    """Return a mapping of root id -> subvolume path for the given mountpoint."""
    rc, out = run_cmd(['btrfs', 'subvolume', 'list', target])
    if rc != 0:
        return {}
    mapping = {}
    for line in out.splitlines():
        line = line.strip()
        match = SUBVOL_RE.match(line)
        if not match:
            continue
        root_id = int(match.group(1))
        path = match.group(2).strip()
        mapping[root_id] = path
    return mapping


def _maybe_extract_int(pattern, text):
    match = pattern.search(text)
    if match:
        try:
            return int(match.group(1))
        except ValueError:
            return None
    return None


def _maybe_extract_text(pattern, text):
    match = pattern.search(text)
    if match:
        return match.group(1).strip()
    return None


def _parse_btrfs_line(line, device_markers, device_token):
    if 'BTRFS' not in line:
        return None
    if not any(marker in line for marker in device_markers):
        return None
    match = BTRFS_JOURNAL_RE.match(line.strip())
    if not match:
        return None
    entry_level = match.group('level').upper()
    if entry_level not in ('WARNING', 'ERROR', 'CRITICAL'):
        return None

    body = match.group('body')
    prefix = match.group('prefix').strip()
    timestamp = prefix
    host = None
    if prefix:
        parts = prefix.split()
        if parts:
            timestamp = parts[0]
            if len(parts) >= 2:
                host = parts[1]

    return {
        'timestamp': timestamp,
        'host': host,
        'level': entry_level,
        'device': device_token,
        'root': _maybe_extract_int(ROOT_RE, body),
        'inode': _maybe_extract_int(INODE_RE, body),
        'logical': _maybe_extract_int(LOGICAL_RE, body),
        'physical': _maybe_extract_int(PHYSICAL_RE, body),
        'offset': _maybe_extract_int(OFFSET_RE, body),
        'length': _maybe_extract_int(LENGTH_RE, body),
        'rel_path': _maybe_extract_text(PATH_RE, body),
        'body': body,
    }


def _summarize_btrfs_entry(entry, subvol_map):
    subvol_desc = None
    if entry['root'] is not None and subvol_map:
        subvol_desc = subvol_map.get(entry['root'])
    root_info = f"root {entry['root']}" if entry['root'] is not None else "root ?"
    if subvol_desc:
        root_info = f"{root_info} ({subvol_desc})"
    rel_path = entry['rel_path'] or "-"
    mount_desc = entry.get('mountpoint') or entry.get('device') or '?'
    uuid = entry.get('uuid') or '?'
    summary = (
        f"{entry['level']} {mount_desc} (UUID {uuid}) {root_info}, "
        f"inode {entry['inode'] or '?'}, path {rel_path}"
    )
    detail_bits = []
    if entry['logical'] is not None:
        detail_bits.append(f"logical {entry['logical']}")
    if entry['physical'] is not None:
        detail_bits.append(f"physical {entry['physical']}")
    if entry['offset'] is not None:
        detail_bits.append(f"offset {entry['offset']}")
    if entry['length'] is not None:
        detail_bits.append(f"length {entry['length']}")
    if detail_bits:
        summary += " (" + ", ".join(detail_bits) + ")"
    if entry['root'] is None and not detail_bits and (entry['rel_path'] in (None, '-', '')):
        summary += f" — {entry['body']}"
    return summary


def _log_error_entry(entry, summary, log, log_format, rotate_size=None):
    if not log:
        return
    entry = entry or {}
    timestamp = entry.get('timestamp')
    host = entry.get('host')
    if not timestamp or not host:
        stamp, hostname = _now_host()
        timestamp = timestamp or stamp
        host = host or hostname
        entry.setdefault('timestamp', timestamp)
        entry.setdefault('host', host)
    prefix = f"{timestamp} {host}"
    if log_format == 'json':
        _append_log(log, f"{prefix} JSON", rotate_size)
        payload = "## JSON START\n" + json.dumps(entry, indent=2) + "\n## JSON END"
        _append_log(log, payload, rotate_size)
    else:
        message = (summary or '').strip()
        if message.startswith('- [') and '] ' in message:
            message = message.split('] ', 1)[1]
        _append_log(log, f"{prefix} {message}", rotate_size)


class BtrfsJournalMonitor:
    """Background journalctl follower for a single device."""

    def __init__(self, mp_info, log, log_format, log_rotate):
        self.mp_info = mp_info
        self.log = log
        self.log_format = log_format
        self.log_rotate = log_rotate
        self.device_path, self.device_token, self.device_markers = _normalize_block_device(
            mp_info.get('source')
        )
        self.subvol_map = parse_subvolume_paths(mp_info['target'])
        self.stop_event = threading.Event()
        self.thread = None
        self.proc = None
        self.header_written = False

    def start(self):
        if not self.device_markers:
            return
        self.thread = threading.Thread(target=self._worker, name=f"btrfs-journal-{self.device_token}")
        self.thread.daemon = True
        self.thread.start()

    def stop(self):
        if not self.thread:
            return
        self.stop_event.set()
        if self.proc and self.proc.poll() is None:
            try:
                self.proc.terminate()
            except ProcessLookupError:
                pass
        if self.thread.is_alive():
            self.thread.join(timeout=5)

    def _worker(self):
        start_time = datetime.now().strftime('%Y-%m-%d %H:%M:%S')
        cmd = [
            'journalctl', '-k', '--output=short-iso', '-S', start_time, '-f', '--no-pager'
        ]
        try:
            self.proc = subprocess.Popen(
                cmd,
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True,
                bufsize=1,
                env=no_lang_env()
            )
        except (OSError, FileNotFoundError) as exc:
            print(f"⚠️  Live journal monitoring unavailable ({exc}).")
            return

        try:
            while not self.stop_event.is_set():
                line = self.proc.stdout.readline()
                if line == '':
                    if self.proc.poll() is not None:
                        break
                    time.sleep(0.1)
                    continue
                entry = _parse_btrfs_line(line, self.device_markers, self.device_token)
                if not entry:
                    continue
                entry['mountpoint'] = self.mp_info.get('target')
                entry['uuid'] = self.mp_info.get('uuid')
                summary = _summarize_btrfs_entry(entry, self.subvol_map)
                print(f"   ⚠️  Live kernel event on {self.device_token}:")
                print(summary)
                _log_error_entry(
                    entry,
                    summary,
                    self.log,
                    self.log_format,
                    self.log_rotate,
                )
                if self.stop_event.is_set():
                    break
        finally:
            if self.proc and self.proc.poll() is None:
                try:
                    self.proc.terminate()
                except ProcessLookupError:
                    pass


def report_btrfs_kernel_errors(mp_info, journal_text, log=None, log_format=None, log_rotate=None):
    """Scan journalctl output for Btrfs errors related to this mount's device."""
    if not journal_text:
        return

    source = mp_info.get('source')
    device_path, device_token, device_markers = _normalize_block_device(source)
    if not device_markers:
        return

    entries = []
    for line in journal_text.splitlines():
        entry = _parse_btrfs_line(line, device_markers, device_token)
        if entry:
            entries.append(entry)

    if not entries:
        return

    subvol_map = None
    if any(entry['root'] for entry in entries):
        subvol_map = parse_subvolume_paths(mp_info['target'])

    print(f"   ⚠️  Kernel reported {len(entries)} Btrfs event(s) on {device_token}:")
    for entry in entries:
        entry['mountpoint'] = mp_info.get('target')
        entry['uuid'] = mp_info.get('uuid')
        summary = _summarize_btrfs_entry(entry, subvol_map)
        print(summary)
        _log_error_entry(entry, summary, log, log_format, log_rotate)





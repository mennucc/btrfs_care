def _parse_size(value):
    suffixes = {
        'k': 1024,
        'kb': 1000,
        'kib': 1024,
        'm': 1024**2,
        'mb': 1000**2,
        'mib': 1024**2,
        'g': 1024**3,
        'gb': 1000**3,
        'gib': 1024**3,
    }
    try:
        s = value.strip().lower()
        for suffix, mult in suffixes.items():
            if s.endswith(suffix):
                return int(float(s[:-len(suffix)]) * mult)
        return int(float(s))
    except (ValueError, TypeError):
        raise argparse.ArgumentTypeError(f"Invalid size: {value}")


def _now_host():
    stamp = datetime.now().astimezone().replace(microsecond=0).isoformat()
    host = socket.gethostname()
    return stamp, host


def parse_args():
    parser = argparse.ArgumentParser(
        description="Automatic scrub/balance maintenance for all mounted Btrfs filesystems."
    )
    parser.add_argument(
        '--no-act', '--noact',
        dest='no_act',
        action='store_true',
        help='Echo btrfs commands instead of executing them (dry-run).'
    )
    parser.add_argument(
        '--scrub-max-age-days',
        type=int,
        default=SCRUB_MAX_AGE_DAYS,
        metavar='DAYS',
        help=f'Skip scrub if last run was newer than DAYS (default {SCRUB_MAX_AGE_DAYS}).'
    )
    parser.add_argument(
        '--log',
        dest='log',
        metavar='PATH',
        help='If set, append parsed Btrfs errors from journalctl to PATH in addition to printing them.'
    )
    parser.add_argument(
        '--log-format',
        dest='log_format',
        metavar='FORMAT',
        choices=('text', 'json'),
        default='text',
        help='format for error log: text (default) or json'
    )
    parser.add_argument(
        '--log-rotate',
        dest='log_rotate',
        metavar='BYTES',
        type=_parse_size,
        help='If set, rotate the error log after it exceeds this size (accepts suffixes like 10MiB, 500k, etc.; single backup PATH.1).'
    )
    parser.add_argument(
        '--test-debug',
        action='store_true',
        help='Run in test mode: enable --no-act, use fakebin/ commands, and bypass root checks.'
    )
    return parser.parse_args()

